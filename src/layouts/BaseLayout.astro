---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartUI from '../components/CartUI.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/site';
import { url } from '../lib/url';

interface Props {
  /** Título de la página, sin el sufijo "· Chacha". Omitir en Inicio. */
  title?: string;
  description?: string;
  /** Imagen para Open Graph: URL absoluta o ruta (se resuelve contra `site`). */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'product';
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} · Piezas únicas pintadas a mano`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={url('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Twitter: clave para compartir por WhatsApp e Instagram -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:type" content={type === 'product' ? 'product' : 'website'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <slot name="head" />

    <!-- Analytics: pegar acá el script cuando se decida sumarlo (ej. Plausible, GA4). -->
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CartUI />
  </body>
</html>
