---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pagina = await getEntry('paginas', 'sobre-nosotras');
if (!pagina) throw new Error('[chacha] Falta src/content/paginas/sobre-nosotras.md');
const { Content } = await render(pagina);
const { titulo, resumen, fotos } = pagina.data;
---
<BaseLayout title={titulo} description={resumen}>
  <article class="container about">
    <header class="page-head">
      <h1>{titulo}</h1>
    </header>
    <div class="layout">
      <div class="prose"><Content /></div>
      {fotos.length > 0 && (
        <div class="fotos">
          {fotos.map((f, i) => (
            <figure>
              <Image src={f.imagen} alt={f.alt} widths={[480, 720, 960]} sizes="(min-width: 48rem) 40vw, 100vw" priority={i === 0} />
            </figure>
          ))}
        </div>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .layout { display: grid; gap: var(--space-8); }
  .fotos { display: grid; gap: var(--space-4); }
  figure { aspect-ratio: 4 / 5; background: var(--color-surface); overflow: hidden; }
  figure img { width: 100%; height: 100%; object-fit: cover; }
  .prose { font-size: 1.0625rem; }
  @media (min-width: 48rem) {
    .layout { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-12); align-items: start; }
  }
</style>
