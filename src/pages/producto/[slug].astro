---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { getProductos, getRelacionados, type Producto } from '../../lib/productos';
import { SECCIONES, labelSubcategoria } from '../../lib/catalogo';
import { formatPrecio } from '../../lib/format';
import { getSite, whatsappLink } from '../../lib/site';
import { url, absoluteUrl } from '../../lib/url';

export async function getStaticPaths() {
  const productos = await getProductos();
  return productos.map((producto) => ({ params: { slug: producto.slug }, props: { producto } }));
}

interface Props { producto: Producto }
const { producto } = Astro.props;

const site = await getSite();
const vendido = producto.estado === 'vendido';
const seccion = SECCIONES[producto.seccion];
const subLabel = labelSubcategoria(producto.seccion, producto.subcategoria);
const seccionUrl = url(`/${producto.seccion}/`);
const subUrl = url(`/${producto.seccion}/#${producto.subcategoria}`);
const precio = formatPrecio(producto.precio);
const relacionados = await getRelacionados(producto);

const productUrl = absoluteUrl(`/producto/${producto.slug}/`, Astro.site);
const consulta = whatsappLink(site.whatsapp, `¡Hola! Quiero consultar por ${producto.nombre} (${productUrl})`);

// Imagen para compartir (WhatsApp/Instagram leen og:image): JPG de 1200px.
const og = await getImage({ src: producto.fotos[0].imagen, width: 1200, format: 'jpg' });
---
<BaseLayout
  title={`${producto.nombre} · ${precio}`}
  description={producto.descripcion}
  image={og.src}
  imageAlt={producto.fotos[0].alt}
  type="product"
>
  <Fragment slot="head">
    <meta property="product:price:amount" content={String(producto.precio)} />
    <meta property="product:price:currency" content="ARS" />
    <meta property="product:availability" content={vendido ? 'out of stock' : 'in stock'} />
  </Fragment>

  <div class="container detail">
    <ProductGallery fotos={producto.fotos} nombre={producto.nombre} />

    <div class="info">
      <nav aria-label="Estás en" class="crumbs">
        <ol role="list">
          <li><a href={seccionUrl}>{seccion.label}</a></li>
          <li><a href={subUrl}>{subLabel}</a></li>
        </ol>
      </nav>

      <h1>{producto.nombre}</h1>
      <p class:list={['price', { muted: vendido }]}>{precio}</p>
      <p class="tag">{seccion.etiqueta}</p>

      <div class="actions">
        {vendido ? (
          <div class="sold" role="status">
            <p><strong>Esta pieza ya fue vendida</strong></p>
            <a href={subUrl}>Ver más de {subLabel}</a>
          </div>
        ) : (
          <div class="cart-actions" data-add-to-cart data-slug={producto.slug}>
            <button type="button" class="btn btn--block" data-add-button>Agregar al carrito</button>
            <p class="in-cart" data-in-cart hidden>
              <span class="btn btn--block" aria-disabled="true">En tu carrito ✓</span>
              <a href={url('/carrito/')}>Ver carrito</a>
            </p>
          </div>
        )}
        <a class="btn btn--secondary btn--block" href={consulta} target="_blank" rel="noopener">
          Consultar por WhatsApp
        </a>
      </div>

      <div class="desc">
        <p>{producto.descripcion}</p>
        <dl>
          <div><dt>Medidas</dt><dd>{producto.medidas}</dd></div>
          <div><dt>Material</dt><dd>{producto.material}</dd></div>
        </dl>
      </div>
    </div>
  </div>

  {relacionados.length > 0 && (
    <section class="container section related" aria-labelledby="rel-title">
      <h2 id="rel-title" class="section-title">También te puede gustar</h2>
      <ProductGrid productos={relacionados} />
    </section>
  )}
</BaseLayout>

<style>
  .detail {
    display: grid;
    gap: var(--space-6);
    padding-top: var(--space-4);
  }
  .info { display: grid; gap: var(--space-3); align-content: start; }
  .crumbs ol { list-style: none; padding: 0; display: flex; flex-wrap: wrap; font-size: var(--fs-meta); color: var(--color-muted); }
  .crumbs li + li::before { content: '›'; margin-inline: var(--space-2); }
  .crumbs a { display: inline-block; padding-block: var(--space-2); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .price { font-size: var(--fs-price); font-weight: 700; }
  .tag {
    font-size: var(--fs-meta);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-accent);
  }
  .actions { display: grid; gap: var(--space-3); margin-block: var(--space-4); }
  :global(.btn--block) { width: 100%; }
  .in-cart { display: grid; gap: var(--space-2); justify-items: center; }
  .in-cart[hidden], .cart-actions [hidden] { display: none; }
  .in-cart a, .sold a { display: inline-flex; align-items: center; min-height: var(--tap); }
  .sold { padding: var(--space-4); background: var(--color-surface); border-radius: var(--radius); }
  .desc { display: grid; gap: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-border); }
  dl { display: grid; gap: var(--space-3); }
  dt { font-size: var(--fs-meta); color: var(--color-muted); text-transform: uppercase; letter-spacing: var(--tracking-caps); }
  .related { border-top: 1px solid var(--color-border); margin-top: var(--space-12); }
  .related h2 { margin-bottom: var(--space-6); }

  @media (min-width: 48rem) {
    .detail { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--space-8); padding-top: var(--space-8); }
    .info { position: sticky; top: calc(var(--header-h) + var(--space-6)); }
  }
  @media (min-width: 64rem) {
    .detail { gap: var(--space-16); }
  }
</style>
