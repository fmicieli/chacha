---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSite, whatsappLink } from '../lib/site';

const site = await getSite();
---
<BaseLayout title="Contacto" description={`Escribinos por WhatsApp. ${site.texto_entregas}`}>
  <section class="container page-head contacto">
    <h1>Contacto</h1>
    <p class="lede">¿Tenés una consulta o querés encargar algo? Escribinos por WhatsApp y te respondemos a la brevedad.</p>

    <a class="btn btn--lg" href={whatsappLink(site.whatsapp, '¡Hola! Tengo una consulta.')} target="_blank" rel="noopener">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
      Escribinos por WhatsApp
    </a>

    <dl class="datos">
      <div>
        <dt>Instagram</dt>
        <dd><a href={site.instagram_url} target="_blank" rel="noopener">Seguinos en Instagram</a></dd>
      </div>
      <div>
        <dt>Zona</dt>
        <dd>{site.zona_entrega}</dd>
      </div>
      <div>
        <dt>Entregas</dt>
        <dd>{site.texto_entregas}</dd>
      </div>
    </dl>
  </section>
</BaseLayout>

<style>
  .contacto { gap: var(--space-6); justify-items: start; }
  .btn--lg { min-height: 56px; padding-inline: var(--space-8); font-size: 1.0625rem; }
  .datos { display: grid; gap: var(--space-6); margin-top: var(--space-6); padding-top: var(--space-8); border-top: 1px solid var(--color-border); width: 100%; }
  dt { font-size: var(--fs-meta); color: var(--color-muted); text-transform: uppercase; letter-spacing: var(--tracking-caps); margin-bottom: var(--space-1); }
  dd a { display: inline-flex; align-items: center; min-height: var(--tap); }
  @media (min-width: 48rem) { .datos { grid-template-columns: repeat(3, 1fr); } }
</style>
