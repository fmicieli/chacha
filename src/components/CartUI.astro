---
/**
 * Partes globales del carrito, incluidas en todas las páginas:
 * contador del header, panel "Agregado a tu carrito", avisos y botones "Agregar al carrito".
 */
import { url } from '../lib/url';
---
<dialog class="drawer" data-cart-drawer aria-labelledby="drawer-title">
  <div class="drawer-head">
    <h2 id="drawer-title">Agregado a tu carrito</h2>
    <button type="button" class="close" data-drawer-close aria-label="Cerrar">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
  </div>
  <div class="drawer-item">
    <img data-drawer-img alt="" width="96" height="120" />
    <div>
      <p class="name" data-drawer-name></p>
      <p class="price" data-drawer-price></p>
    </div>
  </div>
  <div class="drawer-actions">
    <a class="btn" href={url('/carrito/')}>Ir al carrito</a>
    <button type="button" class="btn btn--secondary" data-drawer-close>Seguir mirando</button>
  </div>
</dialog>

<div class="toasts" data-toasts role="status" aria-live="polite"></div>

<script>
  import { agregar, estaEnCarrito, getCarrito, hidratar, onAviso, onCambio, avisar } from '../lib/cart';

  /* Contador del header */
  const actualizarBadge = (n: number) => {
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((b) => {
      b.textContent = String(n);
      b.hidden = n === 0;
    });
    document.querySelectorAll<HTMLElement>('[data-cart-link]').forEach((a) => {
      a.setAttribute('aria-label', `Carrito, ${n} ${n === 1 ? 'producto' : 'productos'}`);
    });
  };
  actualizarBadge(getCarrito().length);
  onCambio((slugs) => actualizarBadge(slugs.length));

  /* Avisos: flotantes, salvo que la página tenga su propio lugar ([data-avisos], ej. el carrito) */
  const toasts = document.querySelector<HTMLElement>('[data-avisos]') ?? document.querySelector<HTMLElement>('[data-toasts]')!;
  onAviso((mensaje) => {
    const t = document.createElement('div');
    t.className = 'toast';
    const p = document.createElement('p');
    p.textContent = mensaje;
    const cerrar = document.createElement('button');
    cerrar.type = 'button';
    cerrar.setAttribute('aria-label', 'Cerrar aviso');
    cerrar.textContent = '×';
    cerrar.addEventListener('click', () => t.remove());
    t.append(p, cerrar);
    toasts.append(t);
  });

  /* Al cargar cualquier página: sacar del carrito lo vendido o eliminado */
  if (getCarrito().length > 0) {
    hidratar()
      .then(({ avisos }) => avisos.forEach(avisar))
      .catch(() => {/* sin conexión: se reintenta en la próxima carga */});
  }

  /* Panel "Agregado a tu carrito" */
  const drawer = document.querySelector<HTMLDialogElement>('[data-cart-drawer]')!;
  let devolverFoco: HTMLElement | null = null;
  drawer.querySelectorAll('[data-drawer-close]').forEach((b) => b.addEventListener('click', () => drawer.close()));
  drawer.addEventListener('click', (e) => { if (e.target === drawer) drawer.close(); }); // click en el fondo
  drawer.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    devolverFoco?.focus();
  });

  function abrirDrawer(d: { nombre: string; precio: string; imagen: string }, foco: HTMLElement | null) {
    drawer.querySelector<HTMLImageElement>('[data-drawer-img]')!.src = d.imagen;
    drawer.querySelector('[data-drawer-name]')!.textContent = d.nombre;
    drawer.querySelector('[data-drawer-price]')!.textContent = d.precio;
    devolverFoco = foco;
    drawer.showModal();
    document.documentElement.style.overflow = 'hidden';
  }

  /* Botones "Agregar al carrito" (detalle de producto) */
  document.querySelectorAll<HTMLElement>('[data-add-to-cart]').forEach((box) => {
    const slug = box.dataset.slug!;
    const boton = box.querySelector<HTMLButtonElement>('[data-add-button]')!;
    const enCarrito = box.querySelector<HTMLElement>('[data-in-cart]')!;
    const verCarrito = enCarrito.querySelector<HTMLAnchorElement>('a');

    const pintar = () => {
      const esta = estaEnCarrito(slug);
      boton.hidden = esta;
      enCarrito.hidden = !esta;
    };
    pintar();
    onCambio(pintar);

    boton.addEventListener('click', () => {
      agregar(slug);
      pintar();
      abrirDrawer(
        { nombre: box.dataset.nombre!, precio: box.dataset.precio!, imagen: box.dataset.imagen! },
        verCarrito,
      );
    });
  });
</script>

<style>
  .drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(100%, 26rem);
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--space-6) var(--gutter);
    border: 0;
    border-left: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
  }
  .drawer[open] { display: flex; flex-direction: column; gap: var(--space-6); }
  .drawer::backdrop { background: rgb(17 17 17 / 0.4); }
  @media (prefers-reduced-motion: no-preference) {
    .drawer[open] { animation: slide-in 0.25s ease-out; }
    @keyframes slide-in { from { transform: translateX(100%); } }
  }
  .drawer-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .drawer-head h2 { font-size: var(--fs-meta); text-transform: uppercase; letter-spacing: var(--tracking-caps); }
  .close {
    display: inline-flex; align-items: center; justify-content: center;
    width: var(--tap); height: var(--tap); margin-right: calc(var(--space-3) * -1);
    border: 0; background: none; cursor: pointer; color: var(--color-text);
  }
  .drawer-item { display: flex; gap: var(--space-4); align-items: center; }
  .drawer-item img { width: 96px; height: 120px; object-fit: cover; background: var(--color-surface); }
  .name { font-weight: 600; }
  .price { font-weight: 700; }
  .drawer-actions { display: grid; gap: var(--space-3); }

  .toasts {
    position: fixed;
    left: var(--gutter);
    right: var(--gutter);
    bottom: var(--space-4);
    z-index: 60;
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    pointer-events: none;
  }
  .toasts :global(.toast) {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    max-width: 32rem;
    width: 100%;
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    background: var(--color-text);
    color: var(--color-bg);
    border-radius: var(--radius);
  }
  .toasts :global(.toast p) { flex: 1; font-size: 0.9375rem; }
  .toasts :global(.toast button) {
    flex: none;
    width: var(--tap); height: var(--tap);
    border: 0; background: none; color: inherit; font-size: 1.5rem; cursor: pointer;
  }
</style>
