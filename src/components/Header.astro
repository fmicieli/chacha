---
import Logo from './Logo.astro';
import { NAV_LINKS } from '../lib/nav';
import { url, isActive } from '../lib/url';

const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="container bar">
    <a href={url('/')} class="logo-link" aria-label="Chacha, ir al inicio"><Logo /></a>

    <nav class="nav-desktop" aria-label="Principal">
      <ul>
        {NAV_LINKS.map(({ href, label }) => (
          <li>
            <a href={url(href)} aria-current={isActive(current, href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a href={url('/carrito/')} class="icon-btn cart-link" data-cart-link aria-label="Carrito, 0 productos">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M5 8h14l-1.2 11.1a1 1 0 0 1-1 .9H7.2a1 1 0 0 1-1-.9L5 8Z" />
          <path d="M9 8V6.5a3 3 0 0 1 6 0V8" />
        </svg>
        <span class="badge" data-cart-count hidden>0</span>
      </a>
      <button type="button" class="icon-btn menu-toggle" aria-label="Abrir menú" aria-haspopup="dialog" aria-controls="mobile-menu" data-menu-open>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <dialog id="mobile-menu" class="mobile-menu" aria-label="Menú">
    <div class="container bar">
      <a href={url('/')} class="logo-link" aria-label="Chacha, ir al inicio"><Logo /></a>
      <button type="button" class="icon-btn" aria-label="Cerrar menú" data-menu-close>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
    <nav class="container" aria-label="Principal (móvil)">
      <ul>
        <li><a href={url('/')} aria-current={current === url('/') ? 'page' : undefined}>Inicio</a></li>
        {NAV_LINKS.map(({ href, label }) => (
          <li>
            <a href={url(href)} aria-current={isActive(current, href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
        <li><a href={url('/carrito/')} aria-current={isActive(current, '/carrito/') ? 'page' : undefined}>Carrito</a></li>
      </ul>
    </nav>
  </dialog>
</header>

<script>
  const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  openBtn?.addEventListener('click', () => {
    menu?.showModal(); // showModal: atrapa el foco y cierra con Escape
    document.documentElement.style.overflow = 'hidden';
  });
  closeBtn?.addEventListener('click', () => menu?.close());
  menu?.addEventListener('close', () => {
    document.documentElement.style.overflow = '';
    openBtn?.focus();
  });
  // Si se agranda la ventana con el menú abierto, cerrarlo.
  matchMedia('(min-width: 48rem)').addEventListener('change', (e) => {
    if (e.matches && menu?.open) menu.close();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: var(--header-h);
  }
  .logo-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    text-decoration: none;
    color: var(--color-text);
  }
  .logo-link:hover { color: var(--color-text); }

  ul { list-style: none; padding: 0; }

  .nav-desktop { display: none; }
  .nav-desktop ul { display: flex; gap: var(--space-8); }
  .nav-desktop a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-size: var(--fs-meta);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  .nav-desktop a[aria-current='page'] { border-bottom-color: var(--color-accent); }

  .actions { display: flex; align-items: center; gap: var(--space-1); margin-right: calc(var(--space-3) * -1); }
  .icon-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius);
    color: var(--color-text);
    cursor: pointer;
  }
  .icon-btn:hover { color: var(--color-accent); }
  .badge {
    position: absolute;
    top: 4px;
    right: 2px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    background: var(--color-accent);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    line-height: 18px;
    text-align: center;
  }
  .badge[hidden] { display: none; }

  .mobile-menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
  }
  .mobile-menu::backdrop { background: var(--color-bg); }
  .mobile-menu .bar { border-bottom: 1px solid var(--color-border); }
  .mobile-menu nav { padding-block: var(--space-6); }
  .mobile-menu a:not(.logo-link) {
    display: flex;
    align-items: center;
    min-height: 56px;
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
  }
  .mobile-menu a[aria-current='page'] { color: var(--color-accent); }

  @media (min-width: 48rem) {
    .nav-desktop { display: block; }
    .menu-toggle { display: none; }
  }
</style>
