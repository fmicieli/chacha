---
import { Image } from 'astro:assets';
import logo from '../assets/marca/logo.png';

// Logo de Chacha (PNG transparente, recortado). Para cambiarlo, reemplazar src/assets/marca/logo.png.
interface Props {
  /** Alto en px en que se muestra. */
  height?: number;
  class?: string;
}
const { height = 52, class: className } = Astro.props;
---
<Image
  src={logo}
  alt="Chacha"
  height={height}
  densities={[1, 2, 3]}
  class:list={['logo', className]}
  loading="eager"
  decoding="async"
/>

<style>
  .logo { display: block; width: auto; }
</style>
