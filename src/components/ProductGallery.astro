---
import { Image } from 'astro:assets';
import type { Producto } from '../lib/productos';

interface Props { fotos: Producto['fotos']; nombre: string }
const { fotos, nombre } = Astro.props;
const multiple = fotos.length > 1;
---
<div class="gallery" data-gallery>
  <div
    class="track"
    data-track
    tabindex={multiple ? 0 : undefined}
    role={multiple ? 'region' : undefined}
    aria-roledescription={multiple ? 'carrusel' : undefined}
    aria-label={multiple ? `Fotos de ${nombre}. Usá las flechas para cambiar de foto.` : undefined}
  >
    {fotos.map((f, i) => (
      <figure class="slide" aria-label={multiple ? `Foto ${i + 1} de ${fotos.length}` : undefined}>
        <Image
          src={f.imagen}
          alt={f.alt}
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 64rem) 50vw, 100vw"
          priority={i === 0}
        />
      </figure>
    ))}
  </div>

  {multiple && (
    <>
      <div class="dots" aria-hidden="true">
        {fotos.map((_, i) => <span class:list={['dot', { active: i === 0 }]} data-dot />)}
      </div>
      <ul class="thumbs" role="list">
        {fotos.map((f, i) => (
          <li>
            <button type="button" class="thumb" data-thumb={i} aria-label={`Ver foto ${i + 1} de ${fotos.length}`} aria-current={i === 0 ? 'true' : undefined}>
              <Image src={f.imagen} alt="" widths={[160, 240]} sizes="6rem" />
            </button>
          </li>
        ))}
      </ul>
    </>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const track = gallery.querySelector<HTMLElement>('[data-track]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const dots = gallery.querySelectorAll<HTMLElement>('[data-dot]');
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>('[data-thumb]');
    if (slides.length < 2) return;

    let current = 0;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setActive = (i: number) => {
      current = i;
      dots.forEach((d, j) => d.classList.toggle('active', j === i));
      thumbs.forEach((t, j) => t.toggleAttribute('aria-current', j === i));
    };
    const goTo = (i: number) => {
      const target = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: slides[target].offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
      setActive(target);
    };

    // Sincroniza indicadores cuando se hace swipe.
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) setActive(slides.indexOf(e.target as HTMLElement));
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((s) => io.observe(s));

    thumbs.forEach((t) => t.addEventListener('click', () => goTo(Number(t.dataset.thumb))));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(current - 1); }
    });
  });
</script>

<style>
  .gallery { display: grid; gap: var(--space-3); min-width: 0; }
  .track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    background: var(--color-surface);
    /* En mobile la galería va de borde a borde */
    margin-inline: calc(var(--gutter) * -1);
  }
  .track::-webkit-scrollbar { display: none; }
  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    aspect-ratio: 4 / 5;
  }
  .slide img { width: 100%; height: 100%; object-fit: cover; }

  .dots { display: flex; justify-content: center; gap: var(--space-2); }
  .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--color-border);
    transition: background-color 0.2s;
  }
  .dot.active { background: var(--color-text); }

  .thumbs { display: none; list-style: none; padding: 0; gap: var(--space-3); }
  .thumb {
    width: 5rem;
    aspect-ratio: 4 / 5;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--color-surface);
    overflow: hidden;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s, border-color 0.2s;
  }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb:hover { opacity: 1; }
  .thumb[aria-current] { opacity: 1; border-color: var(--color-text); }

  @media (min-width: 48rem) {
    .track { margin-inline: 0; }
    .dots { display: none; }
    .thumbs { display: flex; }
  }
</style>
