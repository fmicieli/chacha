---
// Temporal (fase 1): se reemplaza por cada página real en la fase 3.
import { url } from '../lib/url';
interface Props { title: string }
const { title } = Astro.props;
---
<section class="container soon">
  <h1>{title}</h1>
  <p class="muted">Estamos armando esta sección. Volvé pronto.</p>
  <a class="btn btn--secondary" href={url('/')}>Volver al inicio</a>
</section>

<style>
  .soon { padding-block: var(--space-16); display: grid; gap: var(--space-4); justify-items: start; }
</style>
